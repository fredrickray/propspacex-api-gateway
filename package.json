{
  "name": "propspacex-api-gateway",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "build:only": "tsc && tsc-alias",
    "copy:protos": "cp -R src/protos dist/protos",
    "build": "npm run clean && npm run build:only && npm run copy:protos",
    "prestart": "npm run build",
    "start": "node -r tsconfig-paths/register dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredrickray/propspacex-api-gateway.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fredrickray/propspacex-api-gateway/issues"
  },
  "homepage": "https://github.com/fredrickray/propspacex-api-gateway#readme",
  "description": "",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.1",
    "@grpc/proto-loader": "^0.8.0",
    "@types/multer": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "form-data": "^4.0.5",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
